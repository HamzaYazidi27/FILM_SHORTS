# Copy to .env and fill in what you use. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Claude (default provider: providers.llm = "anthropic", model claude-opus-5-5)
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint (e.g. Ollama/LM Studio on Apple Silicon); set
# providers.openai_compatible_base_url/model in the dashboard. Key optional.
OPENAI_COMPATIBLE_API_KEY=

# --- Images / TTS (optional) ------------------------------------------------
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional Pollinations key: removes the free tier's rate limit (1 text reply / 45 s) and logo
POLLINATIONS_API_KEY=

# --- YouTube publishing (optional) -----------------------------------------
# Path to the OAuth 2.0 "Desktop app" client_secret.json from Google Cloud Console
# (YouTube Data API v3 + YouTube Analytics API enabled). Then run:
#   python -m shortsengine youtube-auth
YOUTUBE_CLIENT_SECRETS=

# --- Runtime -----------------------------------------------------------------
# Where settings, the SQLite database, jobs, renders and logs live (default ./data)
SHORTS_DATA_DIR=
